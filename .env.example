# Copy to .env for local (non-Docker) runs. Inside docker-compose these are set directly
# in docker-compose.yml so the services can reach each other by service name.

DATABASE_URL=postgresql+psycopg://northwind:northwind@localhost:5432/northwind
LOG_LEVEL=INFO
ENVIRONMENT=local

# Mock connector behavior (used by lifecycle/provisioning stretch work)
MOCK_ENTRA_FAILURE_RATE=0.0
MOCK_AD_FAILURE_RATE=0.0

# Freshness SLA (hours) a source may be stale before campaign launch is blocked
INGESTION_FRESHNESS_SLA_HOURS=24
